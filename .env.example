# =============================================
# OffRadar - Variables de entorno
# =============================================

# Base de datos PostgreSQL (Hetzner/Coolify)
DATABASE_URL=postgresql://user:password@host:5432/offradar

# GitHub (PAT para scraper - necesario)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Product Hunt API (opcional - para scraper de PH)
PRODUCTHUNT_API_KEY=
PRODUCTHUNT_API_SECRET=

# Reddit API (opcional - para futuro scraper de Reddit)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Gemini API (para generación de imágenes - cuenta nanobanana2)
GEMINI_API_KEY=

# Twitter/X API (para publicación automática)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Resend (newsletter)
RESEND_API_KEY=

# Web
NEXT_PUBLIC_SITE_URL=https://offradar.es

# Storage (Cloudflare R2 - opcional)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
